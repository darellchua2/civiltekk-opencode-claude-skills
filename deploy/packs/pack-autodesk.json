{
  "$comment": "Provider pack: Autodesk Platform Services (APS) MCP servers. Deep-merged into the target opencode.json by deploy/merge-packs.mjs when the user passes --enable-pack autodesk (v2 shape: mcp.servers.<name>.disabled:false + permissions array rules). The 4 Autodesk servers are NOT shipped in the base config — this pack carries their FULL definitions (type/url/headers) plus disabled flags and permissions allows. Requires AUTODESK_API_KEY in the environment.",
  "mcp": {
    "servers": {
      "autodesk-revit": {
        "type": "remote",
        "url": "https://mcp.autodesk.com/revit/v1",
        "headers": {
          "Authorization": "Bearer {env:AUTODESK_API_KEY}"
        },
        "disabled": false
      },
      "autodesk-model-data": {
        "type": "remote",
        "url": "https://mcp.autodesk.com/model-data/v1",
        "headers": {
          "Authorization": "Bearer {env:AUTODESK_API_KEY}"
        },
        "disabled": false
      },
      "autodesk-fusion": {
        "type": "remote",
        "url": "https://mcp.autodesk.com/fusion/v1",
        "headers": {
          "Authorization": "Bearer {env:AUTODESK_API_KEY}"
        },
        "disabled": false
      },
      "autodesk-help": {
        "type": "remote",
        "url": "https://mcp.autodesk.com/help/v1",
        "headers": {
          "Authorization": "Bearer {env:AUTODESK_API_KEY}"
        },
        "disabled": false
      }
    }
  },
  "permissions": [
    { "action": "autodesk-revit*", "resource": "*", "effect": "allow" },
    { "action": "autodesk-model-data*", "resource": "*", "effect": "allow" },
    { "action": "autodesk-fusion*", "resource": "*", "effect": "allow" },
    { "action": "autodesk-help*", "resource": "*", "effect": "allow" }
  ]
}
