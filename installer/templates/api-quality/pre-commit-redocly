#!/bin/sh
# Redocly lint gate on staged OpenAPI specs.
# Template from civiltekk-opencode-claude-skills — https://github.com/darellchua2/civiltekk-opencode-claude-skills
#
# Install (plain git hook):
#   cp pre-commit-redocly .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# Requires: Node/npx on PATH. Exits non-zero on error-level findings (warnings pass).
# Lints the staged file regardless of origin — hand-written and code-generated specs both.
set -e
REDOCLY_VERSION="2.53.3"

staged="$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)(openapi\.(ya?ml|json)|swagger\.(ya?ml|json))$' || true)"
[ -z "$staged" ] && exit 0

status=0
for f in $staged; do
  echo "[redocly] linting $f"
  npx -y "@redocly/cli@${REDOCLY_VERSION}" lint --config redocly.yaml "$f" || status=1
done

if [ "$status" -ne 0 ]; then
  echo "[redocly] FAILED — fix error-level findings before committing." >&2
fi
exit $status
