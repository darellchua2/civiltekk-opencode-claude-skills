    "plugins": [],
    "instructions": [
        "AGENTS.md"
    ],
    "media": {
        "image": {
            "max_width": 6000,
            "max_height": 6000,
            "max_base64_bytes": 7000000
        }
    },
    "commands": {
        "run-plan": {
            "description": "Fully-automated plan execution loop — implement PLAN*.md phase-by-phase (lint+build+test+e2e gate, then commit + push per phase). Deliberate trigger; soft guardrails (the /goal runtime-guarded path returns when the goal plugin ships a v2 release).",
            "template": "Load the skill `plan-automation-loop-skill` and run it to fully implement the plan file given as the argument: $ARGUMENTS",
            "agent": "build"
        },
        "create-ticket": {
            "description": "Create a structured GitHub issue or JIRA ticket — platform detection, structured description, labels, sub-issues. Ticket only: no branch/PLAN/execution (use /run-worktree-pipeline for that).",
            "template": "Load the skill `ticket-creation-skill` and run it with the arguments: $ARGUMENTS",
            "agent": "build"
        },
        "run-worktree-pipeline": {
            "description": "Tracker-ticket-to-merged-PR pipeline via git worktrees — sync, plan, adaptive review, /run-plan, code review, PR merge. Usage: /run-worktree-pipeline [--dry-run] [base-branch] <ticket-refs...>",
            "template": "Load the skill `worktree-pipeline-skill` and run it with the arguments: $ARGUMENTS",
            "agent": "build"
        }
    },
    "providers": {
        "local-llm": {
            "package": "aisdk:@ai-sdk/openai-compatible",
            "name": "Local LLM (llama.cpp)",
            "settings": {
                "baseURL": "http://127.0.0.1:17851/v1"
            },
            "models": {
                "local/gemma-4-E4B-q4_0": {
                    "name": "gemma-4-E4B (local q4_0)",
                    "capabilities": {
                        "input": [
                            "text",
                            "image"
                        ]
                    }
                }
            }
        },
        "vllm": {
            "package": "aisdk:@ai-sdk/openai-compatible",
            "name": "Local LLM (vLLM)",
            "settings": {
                "baseURL": "http://127.0.0.1:17852/v1"
            },
            "models": {
                "local/nemotron-3-nano": {
                    "name": "Nemotron-3-Nano-4B-FP8 (vLLM)",
                    "capabilities": {
                        "input": [
                            "text"
                        ]
                    },
                    "limit": {
                        "context": 200000,
                        "output": 32768
                    }
                }
            }
        },
        "ollama": {
            "package": "aisdk:@ai-sdk/openai-compatible",
            "name": "Ollama (local)",
            "settings": {
                "baseURL": "http://localhost:11434/v1"
            },
            "models": {
                "qwen3-coder:a3b": {
                    "name": "Qwen3-Coder a3b (Ollama)",
                    "limit": {
                        "context": 128000,
                        "output": 65536
                    }
                }
            }
        },
        "zai-custom": {
            "package": "aisdk:@ai-sdk/openai-compatible",
            "name": "Z.AI Coding Plan (Custom)",
            "settings": {
                "baseURL": "https://api.z.ai/api/coding/paas/v4",
                "apiKey": "{env:ZAI_API_KEY}"
            },
            "models": {
                "glm-5.3-flash": {
                    "name": "GLM-5.3 Flash (Custom)",
                    "capabilities": {
                        "tools": true,
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "text"
                        ]
                    },
                    "cost": {
                        "input": 0,
                        "output": 0,
                        "cache": {
                            "read": 0,
                            "write": 0
                        }
                    },
                    "limit": {
                        "context": 1000000,
                        "output": 131072
                    }
                },
                "glm-5.3": {
                    "name": "GLM-5.3 (Custom)",
                    "capabilities": {
                        "tools": true,
                        "input": [
                            "text"
                        ],
                        "output": [
                            "text"
                        ]
                    },
                    "cost": {
                        "input": 0,
                        "output": 0,
                        "cache": {
                            "read": 0,
                            "write": 0
                        }
                    },
                    "limit": {
                        "context": 1000000,
                        "output": 131072
                    }
                }
            }
        }
    },
    "mcp": {
        "servers": {
            "codegraph": {
                "type": "local",
                "command": [
                    "npx",
                    "-y",
                    "@colbymchenry/codegraph",
                    "serve",
                    "--mcp"
                ],
                "disabled": false
            },
            "atlassian": {
                "type": "local",
                "command": [
                    "npx",
                    "-y",
                    "mcp-remote",
                    "https://mcp.atlassian.com/v1/mcp"
                ],
                "disabled": true
            },
            "zai-web-reader": {
                "type": "remote",
                "url": "https://api.z.ai/api/mcp/web_reader/mcp",
                "headers": {
                    "Authorization": "Bearer {env:ZAI_API_KEY}"
                },
                "disabled": false
            },
            "zai-web-search": {
                "type": "remote",
                "url": "https://api.z.ai/api/mcp/web_search_prime/mcp",
                "headers": {
                    "Authorization": "Bearer {env:ZAI_API_KEY}"
                },
                "disabled": false
            },
            "next-devtools": {
                "type": "local",
                "command": [
                    "npx",
                    "-y",
                    "next-devtools-mcp@latest"
                ],
                "environment": {
                    "NEXT_TELEMETRY_DISABLED": "1"
                },
                "disabled": true
            },
            "markitdown": {
                "type": "local",
                "command": [
                    "markitdown-local-mcp"
                ],
                "environment": {
                    "MARKITDOWN_ENABLE_PLUGINS": "false"
                },
                "disabled": true
            },
            "docling": {
                "type": "local",
                "command": [
                    "docling-mcp-server"
                ],
                "environment": {
                    "DOCLING_CONVERSION_MODE": "local"
                },
                "disabled": true
            },
            "chrome-devtools": {
                "type": "local",
                "command": [
                    "npx",
                    "-y",
                    "chrome-devtools-mcp@latest",
                    "--no-usage-statistics",
                    "--no-performance-crux",
                    "--redact-network-headers",
                    "--isolated"
                ],
                "environment": {
                    "CHROME_DEVTOOLS_MCP_NO_UPDATE_CHECKS": "1"
                },
                "disabled": true
            }
        }
    },
    "agents": {
        "build": {
            "permissions": [
                {
                    "action": "subagent",
                    "resource": "*",
                    "effect": "allow"
                }
            ]
        },
        "plan": {
            "permissions": [
                {
                    "action": "edit",
                    "resource": "*",
                    "effect": "ask"
                },
                {
                    "action": "shell",
                    "resource": "*",
                    "effect": "ask"
                },
                {
                    "action": "subagent",
                    "resource": "*",
                    "effect": "allow"
                }
            ]
        },
        "explore": {
            "model": "zai-coding-plan/glm-5.3-flash",
            "permissions": [
                {
                    "action": "read",
                    "resource": "*",
                    "effect": "allow"
                },
                {
                    "action": "read",
                    "resource": "mcp:*",
                    "effect": "deny"
                }
            ]
        },
        "general": {
            "model": "zai-coding-plan/glm-5.3",
            "permissions": [
                {
                    "action": "read",
                    "resource": "*",
                    "effect": "allow"
                },
                {
                    "action": "read",
                    "resource": "mcp:*",
                    "effect": "deny"
                }
            ]
        }
    }
}
