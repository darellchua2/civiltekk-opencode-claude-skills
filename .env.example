# ─── Required ──────────────────────────────────────────────────────────────────
# Z.AI API key (primary LLM provider)
ZAI_API_KEY=

# ─── Optional ──────────────────────────────────────────────────────────────────
# Gemini API key (secondary provider)
GEMINI_API_KEY=

# External port for the OpenCode web endpoint (default: 4097)
OPENCODE_PORT=4097

# OpenCode CLI version to install in the container (default: 2.0.8)
# Check https://www.npmjs.com/package/@opencode/cli for available versions
OPENCODE_VERSION=2.0.8

# ─── Workspace ─────────────────────────────────────────────────────────────────
# Primary host directory mounted as /workspace in the container
# For multiple directories, uncomment extra lines in docker-compose.yml
WORKSPACE_DIR=~/VSCODE

# ─── Git Identity ──────────────────────────────────────────────────────────────
# Used for git commits inside the container
GIT_USER_NAME=
GIT_USER_EMAIL=

# ─── Ponytail (scoped wrapper plugin) ──────────────────────────────────────────
# Lazy-code intensity for coding agents: lite | full | ultra | off (default: full)
# lite  — build what's asked, name the lazier alternative
# full  — the ladder enforced, stdlib/native first (default)
# ultra — YAGNI extremist, deletion before addition
# off   — disable injection globally (per-session /ponytail still works)
PONYTAIL_DEFAULT_MODE=full

# Regex of agent names that SKIP ponytail injection.
# Default (when empty): 7 read-only/research agents + 11 non-coding agents
# (docs, business, integrations, vision) where the lazy-code ruleset is N/A.
# See ponytail-scoped.ts DEFAULT_OFF_PATTERN for the full list.
# Set to override, e.g. ^(explore|general|code-review)$
PONYTAIL_SUBAGENT_OFF=

# Optional per-agent mode overrides as JSON. Unset = PONYTAIL_DEFAULT_MODE governs.
# Example: {"build":"full","code-review-subagent":"lite","plan":"lite"}
PONYTAIL_AGENT_MODE_MAP=

# ─── Local LLM (llama.cpp) ──────────────────────────────────────────────────────
# Enable with: docker compose --profile llm up -d
# Requires: NVIDIA GPU + nvidia-container-toolkit + GGUF model in MODEL_PATH
LLM_PORT=17851
LLM_MODEL=gemma-4-E4B_q4_0-it.gguf
LLM_MMPROJ=gemma-4-E4B-it-mmproj.gguf
LOCAL_LLM_MODEL_PATH=~/.local/share/opencode/models
N_GPU_LAYERS=999
CTX_SIZE=100000

# ─── Local LLM (vLLM) ───────────────────────────────────────────────────────────
# Enable with: docker compose --profile vllm up -d
# Requires: NVIDIA GPU with >=12GB VRAM for google/gemma-4-E4B-it-qat-w4a16-ct
VLLM_PORT=17852
VLLM_MODEL=google/gemma-4-E4B-it-qat-w4a16-ct
VLLM_MODEL_PATH=~/.cache/huggingface
VLLM_MAX_MODEL_LEN=100000
VLLM_GPU_MEMORY_UTIL=0.99

# ─── Docling Document Service ────────────────────────────────────────────────────
# Enable with: docker compose --profile docling up -d
DOCLING_PORT=8751
