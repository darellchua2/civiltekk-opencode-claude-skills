# Docker build context is the repo root (see docker-compose.yml).
# Keep the context lean and exclude secrets/dev artifacts.

# Secrets / env
.env
.env.*
!.env.example

# Version control
.git/
.gitignore
.gitmodules

# Dependencies
node_modules/
**/node_modules/
.venv/
venv/

# Dev / planning artifacts (not needed in the image)
PLANS/
LEARNINGS/
docs/
tests/
.vscode/
.idea/
.DS_Store

# CI / release config
.github/
.releaserc.json

# Python caches
*.pyc
__pycache__/

# Archived skills (keep image small)
skills/_archived/

# Local-runtime symlink bridge (opencode_app/.opencode/* -> repo root content).
# <!-- sanctioned: symlink bridge -->
# Never let the bridge enter the Docker context: COPY follows in-context
# symlinks and would re-smuggle the full tree (incl. _archived/) into the
# image under a prefix the ignore rules above cannot match.
opencode_app/.opencode/agents
opencode_app/.opencode/skills
opencode_app/.opencode/plugins
opencode_app/.opencode/vibeguard.config.json
